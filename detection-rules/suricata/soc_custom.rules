# SOC Lab Custom Suricata Rules
# MITRE ATT&CK mapped network signatures
#
# Action policy: "drop" only takes effect when Suricata is actually running
# inline (SURICATA_IPS_MODE=true, NFQUEUE). In passive IDS mode (the default)
# Suricata cannot block traffic at all, so a "drop" rule behaves exactly like
# "alert" — it only logs. This lets the same rule file serve both modes
# safely: nothing changes in IDS mode, and only these deliberately-chosen
# high-confidence rules actually block once you opt into IPS mode.

# T1059.001 — PowerShell download cradle over HTTP
# Specific artifact string (DownloadString call) — low false-positive risk, safe to block.
drop http $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC | T1059.001 PS DownloadString"; content:"DownloadString"; http_client_body; classtype:trojan-activity; sid:9000001; rev:2;)

# T1557.001 — Responder LLMNR poisoning
# Deliberately left as "alert" even in IPS mode: LLMNR queries are normal
# Windows name-resolution traffic. This rule flags a LLMNR query being seen at
# all (a heuristic, not proof of poisoning) — blocking it network-wide would
# break legitimate name resolution fallback for every Windows host. Detect,
# don't block; use the Responder dashboard + StackStorm to contain the actual
# attacker host instead.
alert udp any any -> any 5355 (msg:"SOC | T1557.001 LLMNR Query — Possible Responder"; content:"|00 00 01 00|"; depth:4; classtype:policy-violation; sid:9000002; rev:1;)

# T1071.001 — Cobalt Strike beacon (malleable profile pattern)
# Specific combined URI+cookie signature — low false-positive risk, safe to block.
drop http $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC | T1071 Cobalt Strike Beacon"; content:"/jquery-3.3.1.min.js"; http_uri; content:"__utmz="; http_cookie; classtype:trojan-activity; sid:9000003; rev:2;)

# T1046 — Network scan (many SYN, few ACK)
# Only matches inside-to-outside scanning ($HOME_NET -> $EXTERNAL_NET), i.e. a
# lab host already behaving like it's compromised — safe to block that host's
# further scan attempts rather than just log them.
drop tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC | T1046 Port Scan Detected"; flags:S; threshold: type both, track by_src, count 50, seconds 10; classtype:attempted-recon; sid:9000004; rev:2;)

# T1110 — SSH brute force
# Standard fail2ban-style threshold — safe to block the offending source.
drop tcp any any -> $HOME_NET 22 (msg:"SOC | T1110 SSH Brute Force"; flow:to_server; threshold: type both, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:9000005; rev:2;)
